# ============================================================
# .gitignore do repositório black-gemine-pro
# BLINDAGEM MÁXIMA: Impede vazamento de chaves, credenciais, sessões e caches
# ============================================================

# --- Segredos, Chaves e Credenciais ---
.blackcore/x_credentials.json
.blackcore/config/
*.json.key
*.key
*.pem
secrets.json
.env
.env.*
*.env
auth-profiles/
credentials*
*token*
id_rsa*
*.p12

# --- Caches e Dependências ---
.blackcore/cache/
node_modules/
.npm/
.cache/
__pycache__/
*.py[cod]

# --- Sessões, Histórico e Logs ---
.blackcore/sessions/
.blackcore/logs/
.blackcore/checkpoints/
.blackcore/history
.blackcore/install-profile
.blackcore/task-recovery/
.blackcore/project-memory/
*.log

# --- Binários pesados e modelos GGUF ---
*.gguf
*.bin
*.pt
*.onnx
